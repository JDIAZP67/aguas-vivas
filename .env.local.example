# Base de datos Neon (obligatoria para guardar datos reales; sin ella el sitio corre en modo demo)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Clave maestra del panel de administración (obligatoria; ingresa en /admin/acceso)
ADMIN_KEY=tu-clave-maestra-secreta

# === Correos (Fase 6) — opcional. Sin SMTP los avisos se omiten y la
# recuperación de clave avisa que contactes al pastor. ===
# Servidor SMTP (ej. tu cuenta MX de Hostinger, Zoho, Brevo, Mailgun…)
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=no-responder@tudominio.com
SMTP_PASS=tu-clave-smtp
SMTP_FROM="Aguas Vivas <no-responder@tudominio.com>"

# Cuenta que recibe los avisos (nueva decisión de fe, donaciones).
# Si se omite, se usa SMTP_FROM.
NOTIFICATION_EMAIL=pastor@tudominio.com

# URL pública para los enlaces de los correos (Vercel: la URL de tu proyecto por defecto)
PUBLIC_BASE_URL=https://tu-proyecto.vercel.app